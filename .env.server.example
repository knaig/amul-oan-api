# Planner lab on a server next to the models: copy to .env, fill the blanks.
ENVIRONMENT=development
APP_NAME="Amul AI planner lab"

# models (fill)
OPENAI_API_KEY=
OSS_INFERENCE_API_KEY=dummy
GEMMA_VLLM_URL=http://<gemma-vllm-host>:8020/v1          # referenced by pipeline.server.yaml (envsubst it, see below)
TRANSLATEGEMMA_URL=http://<translategemma-lb>:18002/v1
PIPELINE_CONFIG_PATH=pipeline.server.resolved.yaml       # envsubst < pipeline.server.yaml > pipeline.server.resolved.yaml
HEALTH_POLLER_ENABLED=true
HEALTH_BREAKER_ENABLED=true

# planner (the recommended shape)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
PLANNER_MODE=llm                     # flip to shadow, then jev, once the lab numbers satisfy you
PLANNER_OVERRIDE_ENABLED=true
PLANNER_CONCURRENT_MODERATION=true   # voice-style: safety check overlaps the agent step; tokens held until the verdict
PLANNER_LAB_ENABLED=true
PLANNER_TRACE_DB_URL=postgresql+asyncpg://user:pass@host:5432/planner   # or sqlite+aiosqlite:///./planner_traces.db

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# REAL network (replace the stand-in): your seeker, ONIX bridge, PashuGPT
AMUL_NETWORK_URL=http://amul-bap-seeker:3000
VISTAAR_SEEKER_URL=http://amul-bap-seeker:3000
BECKN_BAP_CALLER_URL=
BECKN_TRANSACTION_BRIDGE_TOKEN=
BECKN_CALLBACK_TOKEN=
BECKN_BAP_ID=bap.amul-net.internal
BECKN_BAP_URI=
BECKN_AMUL_BPP_ID=bpp-amul.amul-net.internal
BECKN_AMUL_BPP_URI=
VISTAAR_SHC_ENABLED=true
PASHUGPT_TOKEN=
